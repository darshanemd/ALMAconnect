# ==============================================================================
# PROJECT ALMA - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# If deploying frontend and backend together on the same domain/proxy, leave empty.
# If deploying decoupled (e.g. Frontend on Vercel, Backend on Render):
# VITE_API_URL=https://your-backend-service.onrender.com
# VITE_SOCKET_URL=https://your-backend-service.onrender.com
VITE_API_URL=
VITE_SOCKET_URL=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# MongoDB connection URI (e.g. MongoDB Atlas cluster or local container)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/alumniconnect?retryWrites=true&w=majority
# Cryptographically random string for signing JWT tokens
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters

# CORS & Client URLs (comma-separated if multiple origins)
CLIENT_URL=https://your-frontend-domain.com
ALLOWED_ORIGIN=https://your-frontend-domain.com

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (Gmail SMTP - Optional for Password Reset OTPs)
# ------------------------------------------------------------------------------
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME="AlmaConnect Portal"
