# ==============================================================================
# PROJECT ALMA - SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or self-hosted MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/alumniconnect

# Security Secrets (Generate a strong 32+ character random string)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters

# CORS & Client Origins
# Set CLIENT_URL to your public frontend URL for password reset links and CORS
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed origins (e.g. https://alma.yourcollege.edu,https://yourdomain.com)
ALLOWED_ORIGIN=http://localhost:5173

# Python Machine Learning Runtime (optional overrides)
# PYTHON_BIN=python3
# ML_DIR=../ml

# Gmail SMTP Configuration (for password reset OTP & verification emails)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME="AlmaConnect Portal"

# Cloudinary Storage Configuration (Optional for permanent cloud media storage)
# Sign up free at https://cloudinary.com (25GB free storage/bandwidth forever)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

