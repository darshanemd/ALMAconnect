# ==============================================================================
# UNIFIED FULLSTACK DOCKERFILE (Single Container: React + Node.js + Python ML)
# Suitable for 1-click PaaS: Render, Railway, Fly.io, Heroku, AWS App Runner
# ==============================================================================

# Stage 1: Build Vite React Frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Production Fullstack Container
FROM node:20-bookworm-slim

WORKDIR /app

# Install Python 3, pip, venv, and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set up Python isolated virtual environment
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install backend dependencies
COPY server/package*.json ./server/
RUN cd server && npm install --omit=dev

# Install Python ML dependencies
COPY ml/requirements.txt ./ml/
RUN pip install --no-cache-dir -r ./ml/requirements.txt

# Copy backend source, ML models, and compiled frontend build
COPY server/ ./server/
COPY ml/ ./ml/
COPY --from=frontend-builder /app/dist ./dist

# Create uploads directory and set permissions
RUN mkdir -p /app/server/uploads && chown -R node:node /app

WORKDIR /app/server

USER node

EXPOSE 5000

ENV NODE_ENV=production
ENV PORT=5000
ENV PYTHON_BIN=/opt/venv/bin/python
ENV ML_DIR=/app/ml

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

CMD ["node", "server.js"]
